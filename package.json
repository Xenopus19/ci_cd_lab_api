  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Xenopus19/ci_cd_lab_api/issues"
  },
  "homepage": "https://github.com/Xenopus19/ci_cd_lab_api#readme",
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^6.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "packages/*",
    "client-app"
  ]
