  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --no-minify",
    "db:migrate": "sequelize-cli db:migrate --config config/database.cjs --migrations-path database/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config config/database.cjs --migrations-path database/migrations"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xenopus19/ci_cd_lab_api.git"
  },
