server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Only the cats router is forwarded to the API
    location /api/cats {
        proxy_pass ${API_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
